# Copie para apps/api/.env e preencha. Nunca commite o .env real.

# PostgreSQL (Neon). Use a string "pooled" em DATABASE_URL e a direta em DIRECT_URL.
DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx-pooler.REGIAO.aws.neon.tech/pasi?sslmode=require"
DIRECT_URL="postgresql://USUARIO:SENHA@ep-xxxx.REGIAO.aws.neon.tech/pasi?sslmode=require"

# Porta HTTP da API
PORT=3000

# Autenticação JWT — gere um segredo longo e aleatório
JWT_SECRET="troque-este-segredo-por-um-valor-aleatorio-e-longo"
JWT_EXPIRES_IN="1d"

# Endereço do painel web: base do link de redefinição de senha nos e-mails
WEB_URL="http://localhost:5173"
# (legado — usado só se WEB_URL não estiver definido)
APP_URL="http://localhost:3000"

# E-mail transacional pelo Brevo (API HTTPS). Sem a chave, a API só registra
# no log o que enviaria — útil em desenvolvimento.
BREVO_API_KEY=""
MAIL_FROM_EMAIL="pasi.projeto@exemplo.com"
MAIL_FROM_NAME="PASI"
