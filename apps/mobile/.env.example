# Copie para apps/mobile/.env e ajuste.
# URL da API (com o prefixo /api). Sem esta variável o app usa a API local
# (http://localhost:3000/api, ou http://10.0.2.2:3000/api no emulador Android).
EXPO_PUBLIC_API_URL=https://sua-api.onrender.com/api

# API do PASIBot (assistente virtual, repositório chat_com_alunos). Sem esta
# variável o app usa https://finbot-api-rpj9.onrender.com.
EXPO_PUBLIC_ASSISTENTE_API_URL=https://finbot-api-rpj9.onrender.com
