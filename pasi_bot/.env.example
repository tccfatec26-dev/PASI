# Copie para .env e preencha. O .env NUNCA vai para o GitHub (está no .gitignore).

# LLM: groq | gemini | mistral
LLM_PROVEDOR=groq
GROQ_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# LLM_MODELO=openai/gpt-oss-120b   
#(modelos mudam! veja console.groq.com/docs/models)

# Langfuse (Aula 2; deixe vazio por enquanto)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# MongoDB (Aula 3; localmente, o projeto usará PASIbot_dev)
MONGO_URL=mongodb://localhost:27017
MONGO_BANCO=PASIbot_dev

# Ferramentas (Aula 4): CNES, MDS, IBGE e CEP são públicas, sem token.
MAX_PASSOS_AGENTE=5

# RAG (Aula 5)
RAG_MODO=tfidf

